---
// Diagramma "dove si bloccano i progetti AI / come si parte bene": quattro errori e il rimedio di ciascuno, riga per riga.
// SVG inline: usa font e colori del sito. Uso: <ErroriAI caption="…" />
interface Props { caption?: string }
const { caption } = Astro.props;

const ROW_H = 64;
const STEP = 80;
const TOP = 66;
const STRIP_Y = TOP + 3 * STEP + ROW_H + 18;
const STRIP_H = 64;
const H = STRIP_Y + STRIP_H + 20;

const errori = [
  { t: 'Partire dallo strumento', s: 'Si sceglie il tool prima del problema' },
  { t: 'Automatizzare un processo rotto', s: 'Solo più veloce ad andare storto' },
  { t: 'Non misurare niente', s: 'Senza numeri l’AI resta un costo' },
  { t: 'Dipendere da una sola persona', s: 'Se se ne va, il progetto si ferma' },
];
const rimedi = [
  { t: 'Partire dal processo', s: 'Prima si capisce dove si perde tempo' },
  { t: 'Sistemare, poi automatizzare', s: 'Il flusso è chiaro prima di toccarlo' },
  { t: 'Misurare le ore perse', s: 'Si sa quanto vale risolverlo' },
  { t: 'Dare un responsabile', s: 'Il progetto ha chi lo segue e regole' },
];

const descErrori = 'Dove si bloccano i progetti AI: ' + errori.map((e, i) => `${i + 1}. ${e.t}`).join('; ') + '. Non è un problema di tecnologia, ma di metodo.';
const descRimedi = 'Come si parte bene: ' + rimedi.map((e, i) => `${i + 1}. ${e.t}`).join('; ') + '. Un metodo che parte dai bisogni e porta risultati.';
---

<figure class="err">
  <div class="panels">
    <svg class="panel no" viewBox={`0 0 420 ${H}`} role="img" aria-labelledby="err-no-t err-no-d">
      <title id="err-no-t">I quattro errori più comuni nell’adozione dell’AI</title>
      <desc id="err-no-d">{descErrori}</desc>
      <rect class="bg" x="0" y="0" width="420" height={H} rx="14" />
      <text class="head" x="20" y="40">Dove si bloccano i progetti AI</text>
      {errori.map((r, i) => {
        const y = TOP + i * STEP;
        return (
          <g>
            <rect class="row" x="20" y={y} width="380" height={ROW_H} rx="10" />
            <circle class="num" cx="52" cy={y + ROW_H / 2} r="16" />
            <text class="n" x="52" y={y + ROW_H / 2 + 5} text-anchor="middle">{i + 1}</text>
            <text class="t" x="80" y={y + 28}>{r.t}</text>
            <text class="s" x="80" y={y + 49}>{r.s}</text>
          </g>
        );
      })}
      <rect class="strip" x="20" y={STRIP_Y} width="380" height={STRIP_H} rx="12" />
      <text class="strip-v" x="210" y={STRIP_Y + 28} text-anchor="middle">Non è un problema di tecnologia</text>
      <text class="strip-l" x="210" y={STRIP_Y + 49} text-anchor="middle">È un problema di metodo</text>
    </svg>

    <svg class="panel si" viewBox={`0 0 420 ${H}`} role="img" aria-labelledby="err-si-t err-si-d">
      <title id="err-si-t">Come si parte bene con l’AI</title>
      <desc id="err-si-d">{descRimedi}</desc>
      <rect class="bg" x="0" y="0" width="420" height={H} rx="14" />
      <text class="head" x="20" y="40">Come si parte bene</text>
      {rimedi.map((r, i) => {
        const y = TOP + i * STEP;
        return (
          <g>
            <rect class="row" x="20" y={y} width="380" height={ROW_H} rx="10" />
            <circle class="num" cx="52" cy={y + ROW_H / 2} r="16" />
            <text class="n" x="52" y={y + ROW_H / 2 + 5} text-anchor="middle">{i + 1}</text>
            <text class="t" x="80" y={y + 28}>{r.t}</text>
            <text class="s" x="80" y={y + 49}>{r.s}</text>
          </g>
        );
      })}
      <rect class="strip" x="20" y={STRIP_Y} width="380" height={STRIP_H} rx="12" />
      <text class="strip-v" x="210" y={STRIP_Y + 28} text-anchor="middle">Un metodo, non uno strumento</text>
      <text class="strip-l" x="210" y={STRIP_Y + 49} text-anchor="middle">Parte dai bisogni e porta risultati</text>
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .err { margin: 2.4rem 0; }
  .panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .panel { width: 100%; height: auto; display: block; font-family: var(--font-body); }
  .panel .head { font-family: var(--font-head); font-weight: 800; font-size: 19px; fill: var(--ink); }
  .panel .t { font-family: var(--font-head); font-weight: 700; font-size: 17px; fill: var(--ink); }
  .panel .s { font-size: 14.5px; fill: var(--ink-2); }
  .panel .n { font-family: var(--font-head); font-weight: 800; font-size: 15px; fill: #fff; }
  .panel .row { fill: #fff; stroke-width: 1.5; }
  .panel .strip-v { font-family: var(--font-head); font-weight: 800; font-size: 17px; }
  .panel .strip-l { font-size: 14.5px; fill: #fff; }

  .no .bg { fill: var(--paper-2); stroke: var(--line); stroke-width: 1.5; }
  .no .row { stroke: var(--line); }
  .no .num { fill: var(--magenta); }
  .no .strip { fill: var(--magenta); }
  .no .strip-v { fill: #fff; }

  .si .bg { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .si .row { stroke: var(--accent); }
  .si .num { fill: var(--accent-strong); }
  .si .strip { fill: var(--ink); }
  .si .strip-v { fill: var(--accent-light); }

  figcaption { margin-top: .8rem; font-size: .95rem; color: var(--ink-2); text-align: center; }
  @media (max-width: 760px) { .panels { grid-template-columns: 1fr; } }
</style>
