---
// Infografica con zoom a tutto schermo (dialog nativo). Uso: <Infographic src={img} alt="…" caption="…" /> (import dell'immagine nel .mdx)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
---

<figure class="info not-prose">
  <button type="button" class="open" aria-label={`Ingrandisci: ${alt}`}>
    <Image src={src} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 1000px) 92vw, 960px" loading="lazy" />
  </button>
  <p class="hint">Tocca per ingrandire</p>
  {caption && <figcaption>{caption}</figcaption>}
  <dialog class="zoom">
    <form method="dialog"><button class="close" aria-label="Chiudi">✕</button></form>
    <Image src={src} alt={alt} widths={[1280, 1920]} sizes="96vw" loading="lazy" />
  </dialog>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('figure.info').forEach((fig) => {
    const dlg = fig.querySelector('dialog') as HTMLDialogElement;
    fig.querySelector('.open')?.addEventListener('click', () => dlg.showModal());
    dlg.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName !== 'BUTTON') dlg.close(); });
  });
</script>

<style>
  .info { margin: 2.2rem 0; text-align: center; }
  .open { display: block; width: 100%; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; cursor: zoom-in; overflow: hidden; }
  .open :global(img) { width: 100%; height: auto; margin: 0; }
  .hint { margin: .5rem 0 0; font-size: .8rem; color: var(--ink-2); }
  figcaption { margin-top: .6rem; font-size: .95rem; color: var(--ink-2); }
  dialog.zoom { max-width: 96vw; max-height: 96vh; padding: .5rem; border: 0; border-radius: var(--radius); background: #fff; overflow: auto; }
  dialog.zoom::backdrop { background: rgba(11,15,22,.85); }
  dialog.zoom :global(img) { width: auto; max-width: 100%; max-height: 90vh; margin: 0 auto; cursor: zoom-out; }
  .close { position: absolute; top: .6rem; right: .6rem; width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 0; background: var(--ink); color: #fff; font-size: 1rem; cursor: pointer; }
</style>
