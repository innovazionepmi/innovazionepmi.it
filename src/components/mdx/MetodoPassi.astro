---
// Il metodo in 5 passi, con i primi tre coperti dall'Acceleratore e gli ultimi due "dopo, solo se serve".
// SVG inline in due versioni (orizzontale su desktop, verticale su telefono): usa font e colori del sito. Uso: <MetodoPassi caption="…" />
interface Props { caption?: string }
const { caption } = Astro.props;

const passi = [
  { t: ['Raccolta dati', 'aziendali'], s: ['questionario', 'guidato'], sm: 'questionario guidato', inclusa: true },
  { t: ['Analisi', 'personalizzata'], s: ['individua le aree', 'ad alto impatto'], sm: 'individua le aree ad alto impatto', inclusa: true },
  { t: ['Priorità', 'd’intervento'], s: ['focus su ciò che', 'genera valore'], sm: 'focus su ciò che genera valore', inclusa: true },
  { t: ['Casi d’uso AI', 'su misura'], s: ['idee concrete e', 'applicabili'], sm: 'idee concrete e applicabili', inclusa: false },
  { t: ['Adozione AI', 'in azienda'], s: ['risultati', 'misurabili'], sm: 'risultati misurabili', inclusa: false },
];
const desc = 'Il metodo Innovazione PMI in 5 passi: ' + passi.map((p, i) => `${i + 1}. ${p.t.join(' ')}`).join('; ')
  + '. I primi tre passi sono compresi nell’Acceleratore; gli ultimi due arrivano dopo la consulenza, solo se serve. Risultato finale: un piano d’azione chiaro, concreto e personalizzato.';

// Versione desktop
const COL = 160, GAP = 20, CARD_Y = 52, CARD_H = 162;
const x = (i: number) => i * (COL + GAP);
const D_STRIP_Y = CARD_Y + CARD_H + 20;
const D_H = D_STRIP_Y + 56 + 16;

// Versione telefono
const R_H = 64, R_STEP = 76;
const M_G1 = 36;
const M_G2 = M_G1 + 3 * R_STEP + 24 + 24;
const ry = (i: number) => (i < 3 ? M_G1 + i * R_STEP : M_G2 + (i - 3) * R_STEP);
const M_STRIP_Y = M_G2 + 2 * R_STEP + 8;
const M_H = M_STRIP_Y + 92 + 16;
---

<figure class="mp">
  <svg class="desk" viewBox={`0 0 880 ${D_H}`} role="img" aria-labelledby="mp-d-t mp-d-d">
    <title id="mp-d-t">Il metodo Innovazione PMI in 5 passi</title>
    <desc id="mp-d-d">{desc}</desc>

    <text class="glab g-in" x="0" y="20">Compreso nell’Acceleratore</text>
    <path class="gline g-in" d={`M0 36 V30 H${x(2) + COL} V36`} />
    <text class="glab g-out" x={x(3)} y="20">Dopo la consulenza, solo se serve</text>
    <path class="gline g-out" d={`M${x(3)} 36 V30 H${x(4) + COL} V36`} />

    {passi.map((p, i) => (
      <g class={p.inclusa ? 'in' : 'out'}>
        <rect class="card" x={x(i)} y={CARD_Y} width={COL} height={CARD_H} rx="14" />
        <circle class="num" cx={x(i) + 30} cy={CARD_Y + 30} r="16" />
        <text class="n" x={x(i) + 30} y={CARD_Y + 35} text-anchor="middle">{i + 1}</text>
        <text class="t" x={x(i) + 16} y={CARD_Y + 82}>{p.t[0]}</text>
        <text class="t" x={x(i) + 16} y={CARD_Y + 102}>{p.t[1]}</text>
        <text class="s" x={x(i) + 16} y={CARD_Y + 130}>{p.s[0]}</text>
        <text class="s" x={x(i) + 16} y={CARD_Y + 148}>{p.s[1]}</text>
      </g>
    ))}

    <rect class="strip" x="0" y={D_STRIP_Y} width="880" height="56" rx="12" />
    <text class="strip-t" x="440" y={D_STRIP_Y + 34} text-anchor="middle"><tspan class="strip-b">Risultato finale:</tspan> un piano d’azione chiaro, concreto e personalizzato per usare l’AI dove serve.</text>
  </svg>

  <svg class="mob" viewBox={`0 0 380 ${M_H}`} role="img" aria-labelledby="mp-m-t mp-m-d">
    <title id="mp-m-t">Il metodo Innovazione PMI in 5 passi</title>
    <desc id="mp-m-d">{desc}</desc>

    <text class="glab g-in" x="0" y="20">Compreso nell’Acceleratore</text>
    <text class="glab g-out" x="0" y={M_G2 - 16}>Dopo la consulenza, solo se serve</text>

    {passi.map((p, i) => (
      <g class={p.inclusa ? 'in' : 'out'}>
        <rect class="card" x="0" y={ry(i)} width="380" height={R_H} rx="12" />
        <circle class="num" cx="34" cy={ry(i) + R_H / 2} r="16" />
        <text class="n" x="34" y={ry(i) + R_H / 2 + 5} text-anchor="middle">{i + 1}</text>
        <text class="t" x="66" y={ry(i) + 28}>{p.t.join(' ')}</text>
        <text class="s" x="66" y={ry(i) + 48}>{p.sm}</text>
      </g>
    ))}

    <rect class="strip" x="0" y={M_STRIP_Y} width="380" height="92" rx="12" />
    <text class="strip-t" x="190" y={M_STRIP_Y + 30} text-anchor="middle"><tspan class="strip-b">Risultato finale:</tspan> un piano d’azione</text>
    <text class="strip-t" x="190" y={M_STRIP_Y + 52} text-anchor="middle">chiaro, concreto e personalizzato</text>
    <text class="strip-t" x="190" y={M_STRIP_Y + 74} text-anchor="middle">per usare l’AI dove serve.</text>
  </svg>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .mp { margin: 2.4rem 0; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-body); }
  .mob { display: none; }
  .glab { font-family: var(--font-head); font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .g-in { fill: var(--accent-strong); }
  .g-out { fill: var(--ink-2); }
  .gline { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .gline.g-in { stroke: var(--accent-strong); }
  .gline.g-out { stroke: var(--ink-2); stroke-dasharray: 5 5; }

  .card { stroke-width: 2; }
  .t { font-family: var(--font-head); font-weight: 700; font-size: 16px; fill: var(--ink); }
  .s { font-size: 13.5px; fill: var(--ink-2); }
  .n { font-family: var(--font-head); font-weight: 800; font-size: 15px; fill: #fff; }
  .in .card { fill: #fff; stroke: var(--accent); }
  .in .num { fill: var(--accent-strong); }
  .out .card { fill: var(--paper-2); stroke: var(--line); stroke-dasharray: 6 5; }
  .out .num { fill: var(--ink-2); }

  .strip { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .strip-t { font-size: 15px; fill: var(--ink); }
  .strip-b { font-family: var(--font-head); font-weight: 800; }

  figcaption { margin-top: .8rem; font-size: .95rem; color: var(--ink-2); text-align: center; }
  @media (max-width: 760px) {
    .desk { display: none; }
    .mob { display: block; }
    .t { font-size: 16px; }
  }
</style>
