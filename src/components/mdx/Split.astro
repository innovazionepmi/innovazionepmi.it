---
// Testo + immagine affiancati. Uso: <Split image={img} alt="…" flip>testo markdown</Split>
// `img` si importa in cima al file .mdx: import img from '../../assets/img/x.jpg';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt?: string; flip?: boolean }
const { image, alt = '', flip = false } = Astro.props;
---

<div class:list={['split', { flip }]}>
  <div class="txt"><slot /></div>
  <Image src={image} alt={alt} widths={[360, 560, 800]} sizes="(max-width: 760px) 92vw, 460px" loading="lazy" />
</div>

<style>
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; margin-block: 2.5rem; }
  .split.flip :global(img) { order: -1; }
  .split :global(img) { border-radius: var(--radius); width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; box-shadow: 12px 12px 0 var(--accent); margin: 0; }
  .txt :global(> * + *) { margin-top: 1em; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } .split.flip :global(img) { order: 0; } }
</style>
