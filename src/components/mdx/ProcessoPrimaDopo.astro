---
// Diagramma "prima / dopo" di un processo (gestione ordine). SVG inline: usa font e colori del sito.
// Uso: <ProcessoPrimaDopo caption="…" />
interface Props { caption?: string }
const { caption } = Astro.props;

const ROW_H = 64;
const STEP = 90; // altezza riga + spazio per la freccia
const TOP = 66;

const prima = [
  { t: 'Ordine via email', s: 'Arriva in una casella personale' },
  { t: 'Copia su Excel', s: 'Le vendite ricopiano i dati a mano', tag: 'duplicati' },
  { t: 'Reinserimento nel gestionale', s: 'L’amministrazione ridigita tutto', tag: 'errori' },
  { t: 'Firma su carta', s: 'L’approvazione passa di mano in mano', tag: 'attese' },
  { t: 'Telefonate per lo stato', s: 'Nessuno sa a che punto è l’ordine' },
];
const dopo = [
  { t: 'Ordine registrato', s: 'Una sola volta, in un solo posto' },
  { t: 'Dati sincronizzati', s: 'Gestionale e reparti sempre allineati' },
  { t: 'Approvazione digitale', s: 'Firma elettronica e notifica automatica' },
  { t: 'Stato sempre visibile', s: 'Dashboard con KPI in tempo reale' },
];

const descPrima = 'Prima: ' + prima.map((p, i) => `${i + 1}. ${p.t}`).join('; ') + '.';
const descDopo = 'Dopo: ' + dopo.map((p, i) => `${i + 1}. ${p.t}`).join('; ') + '.';
---

<figure class="ba">
  <div class="panels">
    <svg class="panel prima" viewBox="0 0 420 510" role="img" aria-labelledby="ba-prima-t ba-prima-d">
      <title id="ba-prima-t">Gestione di un ordine: processo manuale</title>
      <desc id="ba-prima-d">{descPrima}</desc>
      <defs>
        <marker id="ba-arrow-p" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M1 1 L9 5 L1 9 Z" class="ah-p" /></marker>
      </defs>
      <rect class="bg" x="0" y="0" width="420" height="510" rx="14" />
      <text class="head" x="20" y="40">Prima: processo manuale</text>
      {prima.map((r, i) => {
        const y = TOP + i * STEP;
        return (
          <g>
            <rect class="row" x="20" y={y} width="380" height={ROW_H} rx="10" />
            <circle class="num" cx="52" cy={y + ROW_H / 2} r="16" />
            <text class="n" x="52" y={y + ROW_H / 2 + 5} text-anchor="middle">{i + 1}</text>
            <text class="t" x="80" y={y + 28}>{r.t}</text>
            <text class="s" x="80" y={y + 49}>{r.s}</text>
            {r.tag && (
              <g>
                <rect class="tag" x="326" y={y - 11} width="70" height="22" rx="11" />
                <text class="tagt" x="361" y={y + 4} text-anchor="middle">{r.tag}</text>
              </g>
            )}
            {i < prima.length - 1 && <line class="arr-p" x1="210" y1={y + ROW_H + 4} x2="210" y2={y + STEP - 4} marker-end="url(#ba-arrow-p)" />}
          </g>
        );
      })}
    </svg>

    <svg class="panel dopo" viewBox="0 0 420 510" role="img" aria-labelledby="ba-dopo-t ba-dopo-d">
      <title id="ba-dopo-t">Gestione di un ordine: processo innovato</title>
      <desc id="ba-dopo-d">{descDopo} Fino al 30–40% di tempi operativi in meno in alcuni flussi.</desc>
      <defs>
        <marker id="ba-arrow-d" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M1 1 L9 5 L1 9 Z" class="ah-d" /></marker>
      </defs>
      <rect class="bg" x="0" y="0" width="420" height="510" rx="14" />
      <text class="head" x="20" y="40">Dopo: processo innovato</text>
      {dopo.map((r, i) => {
        const y = TOP + i * STEP;
        return (
          <g>
            <rect class="row" x="20" y={y} width="380" height={ROW_H} rx="10" />
            <circle class="num" cx="52" cy={y + ROW_H / 2} r="16" />
            <text class="n" x="52" y={y + ROW_H / 2 + 5} text-anchor="middle">{i + 1}</text>
            <text class="t" x="80" y={y + 28}>{r.t}</text>
            <text class="s" x="80" y={y + 49}>{r.s}</text>
            <line class="arr-d" x1="210" y1={y + ROW_H + 4} x2="210" y2={y + STEP - 4} marker-end="url(#ba-arrow-d)" />
          </g>
        );
      })}
      <g>
        <rect class="stat" x="20" y={TOP + dopo.length * STEP} width="380" height="76" rx="12" />
        <text class="stat-v" x="210" y={TOP + dopo.length * STEP + 33} text-anchor="middle">Fino al 30–40%</text>
        <text class="stat-l" x="210" y={TOP + dopo.length * STEP + 56} text-anchor="middle">di tempi operativi in meno in alcuni flussi</text>
      </g>
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ba { margin: 2.4rem 0; }
  .panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .panel { width: 100%; height: auto; display: block; font-family: var(--font-body); }
  .panel .head { font-family: var(--font-head); font-weight: 800; font-size: 19px; fill: var(--ink); }
  .panel .t { font-family: var(--font-head); font-weight: 700; font-size: 17px; fill: var(--ink); }
  .panel .s { font-size: 14.5px; fill: var(--ink-2); }
  .panel .n { font-family: var(--font-head); font-weight: 800; font-size: 15px; fill: #fff; }
  .panel .row { fill: #fff; stroke-width: 1.5; }
  .panel .tagt { font-family: var(--font-head); font-weight: 700; font-size: 12.5px; fill: #fff; }

  .prima .bg { fill: var(--paper-2); stroke: var(--line); stroke-width: 1.5; }
  .prima .row { stroke: var(--line); }
  .prima .num { fill: var(--magenta); }
  .prima .tag { fill: var(--magenta); }
  .prima .arr-p { stroke: var(--magenta); stroke-width: 2.5; stroke-dasharray: 5 5; }
  .prima .ah-p { fill: var(--magenta); }

  .dopo .bg { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .dopo .row { stroke: var(--accent); }
  .dopo .num { fill: var(--accent-strong); }
  .dopo .arr-d { stroke: var(--accent-strong); stroke-width: 2.5; }
  .dopo .ah-d { fill: var(--accent-strong); }
  .dopo .stat { fill: var(--ink); }
  .dopo .stat-v { font-family: var(--font-head); font-weight: 800; font-size: 24px; fill: var(--accent-light); }
  .dopo .stat-l { font-size: 14.5px; fill: #fff; }

  figcaption { margin-top: .8rem; font-size: .95rem; color: var(--ink-2); text-align: center; }
  @media (max-width: 760px) { .panels { grid-template-columns: 1fr; } }
</style>
