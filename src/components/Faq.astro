---
// Domande frequenti: accordion nativo (<details>), tutto il testo è nel DOM e quindi indicizzabile.
interface Props { items: { q: string; a: string }[]; title?: string; eyebrow?: string }
const { items, title = 'Domande frequenti', eyebrow = 'FAQ' } = Astro.props;
---

{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-title">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="faq-title">{title}</h2>
    <div class="list">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq { max-width: 820px; margin-inline: auto; }
  .list { display: grid; gap: .8rem; margin-top: 1.5rem; }
  details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 1.4rem; }
  details[open] { border-color: var(--ink); box-shadow: -6px 0 0 var(--accent); }
  summary { cursor: pointer; list-style: none; padding: 1.1rem 2rem 1.1rem 0; font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 1.6rem; line-height: 1; }
  details[open] summary::after { content: '–'; }
  p { margin: 0 0 1.2rem; color: var(--ink-2); }
</style>
