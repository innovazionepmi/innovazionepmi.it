---
// Icone a linea del sito (24x24, tratto arrotondato). Il colore segue --ci (inchiostro dell'icona) e --c (fondo morbido),
// impostati dalla rotazione colori `.rot` delle card.
interface Props { name: 'processi' | 'automazione' | 'marketing' }
const { name } = Astro.props;
---

<span class="ico" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {name === 'processi' && (
      <>
        <rect x="3" y="3.5" width="6.5" height="5.5" rx="1.3" />
        <rect x="14.5" y="3.5" width="6.5" height="5.5" rx="1.3" />
        <rect x="8.75" y="15" width="6.5" height="5.5" rx="1.3" />
        <path d="M6.25 9v3h11.5V9M12 12v3" />
      </>
    )}
    {name === 'automazione' && (
      <>
        <rect x="6.5" y="6.5" width="11" height="11" rx="2.2" />
        <path d="M10 3v3.5M14 3v3.5M10 17.5V21M14 17.5V21M3 10h3.5M3 14h3.5M17.5 10H21M17.5 14H21" />
        <path d="M12 9.3l.85 1.85 1.85.85-1.85.85L12 14.7l-.85-1.85-1.85-.85 1.85-.85z" />
      </>
    )}
    {name === 'marketing' && (
      <>
        <path d="M3 21h18" />
        <path d="M4.5 16.5l5-5 3.5 3.5 6.5-7" />
        <path d="M15 8h4.5v4.5" />
      </>
    )}
  </svg>
</span>

<style>
  .ico { display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 16px; margin-bottom: .6rem; color: var(--ci, var(--accent-strong)); background: color-mix(in srgb, var(--c, var(--accent)) 14%, #fff); }
</style>
