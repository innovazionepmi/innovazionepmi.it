---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'articoli'> }
const { post } = Astro.props;
const d = post.data;
const date = d.date.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<a class="card" href={`/blog/${post.id}/`}>
  {d.cover && <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[320, 480, 640]} sizes="(max-width: 700px) 90vw, 360px" loading="lazy" />}
  <div class="body">
    <p class="meta">{d.categories[0] ?? 'articolo'} · <time datetime={d.date.toISOString().slice(0, 10)}>{date}</time></p>
    <h3>{d.title}</h3>
    <p class="desc">{d.description}</p>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .2s, box-shadow .2s; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0,0,0,.1); }
  .card :global(img) { aspect-ratio: 16/9; object-fit: cover; width: 100%; height: auto; border-bottom: 4px solid var(--accent); }
  .body { padding: 1.3rem 1.4rem 1.6rem; }
  .meta { margin: 0 0 .5rem; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
  h3 { font-size: 1.25rem; margin-bottom: .5rem; }
  .desc { margin: 0; color: var(--ink-2); font-size: .98rem; line-height: 1.55; }
</style>
