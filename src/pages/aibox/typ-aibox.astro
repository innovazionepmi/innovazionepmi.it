---
import Base from '../../layouts/Base.astro';
---

<Base title="Richiesta ricevuta: AIBox" description="Abbiamo ricevuto la tua richiesta di demo di AIBox: un consulente ti contatterà entro 1–2 giorni lavorativi." noindex>
  <section class="section">
    <div class="wrap ty">
      <p class="eyebrow">AIBox</p>
      <h1>Richiesta <span class="mark">ricevuta</span></h1>
      <p class="lead">Grazie! Ti contatteremo presto. Un nostro consulente ti scriverà entro 1–2 giorni lavorativi per fissare la demo.</p>
      <ol>
        <li>Riceverai una email di conferma con il riepilogo della tua richiesta.</li>
        <li>Il nostro team ti contatterà per fissare la demo nel momento più comodo per te.</li>
        <li>In 20 minuti scoprirai come AIBox può trasformare la gestione del sapere nella tua azienda.</li>
      </ol>
      <p><a class="btn" href="/servizi/">Scopri tutti i servizi</a></p>
    </div>
  </section>
</Base>

<style>
  .ty { max-width: 720px; }
  .lead { font-size: 1.2rem; color: var(--ink-2); }
  ol { padding-left: 1.2rem; display: grid; gap: .6rem; margin-block: 1.5rem 2rem; }
</style>
