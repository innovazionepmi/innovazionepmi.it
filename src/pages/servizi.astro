---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { aree, percorsi, site } from '../data/site';

const crumbs = [{ name: 'Servizi', path: '/servizi/' }];
const abs = (p: string) => new URL(p, site.url).toString();
const graph = [{
  '@type': 'ItemList',
  itemListElement: [...aree, ...percorsi].map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.label, url: s.external ? s.href : abs(s.href) })),
}];
---

<Base title="Servizi per le PMI" description="Innovazione dei processi, automazione intelligente, AIBox e Acceleratore per Adozione AI: i servizi di Innovazione PMI per le imprese italiane." crumbs={crumbs} graph={graph} webPageType="CollectionPage">
  <section class="head">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Servizi</p>
      <h1>Come possiamo aiutare la tua <span class="mark">impresa</span></h1>
      <p class="lead">Tre aree di intervento e due percorsi pensati per partire in modo concreto: dall’analisi dei processi all’intelligenza artificiale applicata al lavoro di tutti i giorni.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Dove interveniamo</h2>
      <div class="cards rot">
        {aree.map((s) => (
          <a class="svc" href={s.href} rel={s.external ? 'noopener' : undefined}>
            <Icon name={s.icon} />
            <h3>{s.title}{s.external ? ' ↗' : ''}</h3>
            <p>{s.text}</p>
            <span class="svc-go">Scopri di più →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>Prodotti e percorsi</h2>
      <div class="cards two rot">
        {percorsi.map((s) => (
          <a class="svc" href={s.href}>
            <span class="kicker">{s.kicker}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="svc-go">Scopri di più →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(3rem, 7vw, 5rem) 1rem; }
  .lead { font-size: 1.15rem; color: var(--ink-2); max-width: 60ch; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .cards.two { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .svc { background: #fff; border-radius: var(--radius); text-decoration: none; border: 1px solid var(--line); border-top: 4px solid var(--c, var(--accent)); padding: 1.8rem; display: flex; flex-direction: column; gap: .5rem; transition: transform .2s, box-shadow .2s; }
  .svc:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(16,21,31,.12); }
  .svc h3 { margin: 0; }
  .svc p { margin: 0; color: var(--ink-2); font-size: .98rem; }
  .svc-go { margin-top: auto; padding-top: .8rem; font-family: var(--font-head); font-weight: 700; }
  .kicker { font-family: var(--font-head); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--magenta); }
</style>
